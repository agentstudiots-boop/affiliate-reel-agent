{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentstudiots-boop/affiliate-reel-agent/docs/ai-business/coordination/schema/task.schema.json",
  "title": "Übergabedatei einer Entwicklungsaufgabe (Schreibrecht: implementierendes System)",
  "description": "Keine Geschäftsdaten, Finanzzahlen, Secrets oder personenbezogenen Daten – das Repository ist öffentlich.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "title", "module", "phase", "status", "responsible", "implementer", "reviewer",
    "base_commit", "branch", "depends_on", "claims", "changed_files", "implemented", "tests", "known_issues", "open_decisions",
    "pr", "approval", "next_steps", "session", "revision", "updated_at", "log"],
  "$defs": {
    "system": { "enum": ["claude-code", "gpt-work", "operator"] },
    "sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^[A-J]-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 140 },
    "module": { "type": "string", "description": "Modul-ID aus ownership.json" },
    "phase": { "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"] },
    "status": { "enum": ["planned", "in_progress", "in_review", "changes_requested", "approved_by_reviewer", "merged", "deployed", "verified", "blocked", "cancelled"] },
    "responsible": { "$ref": "#/$defs/system" },
    "implementer": { "$ref": "#/$defs/system" },
    "reviewer": { "$ref": "#/$defs/system", "description": "Muss sich vom implementer unterscheiden (Prüfung im Validator, Phase C)." },
    "base_commit": { "$ref": "#/$defs/sha" },
    "branch": { "type": ["string", "null"] },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^[A-J]-[0-9]{2}$" } },
    "claims": {
      "type": "object", "additionalProperties": false, "required": ["paths", "hot_files", "migration_numbers"],
      "properties": {
        "paths": { "type": "array", "items": { "type": "string" }, "description": "Globs, die nur diese Aufgabe ändert" },
        "hot_files": { "type": "array", "items": { "type": "string" }, "description": "Hot Files mit dokumentierter Abstimmung" },
        "migration_numbers": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{3}$" } }
      }
    },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "implemented": { "type": "array", "items": { "type": "string" }, "description": "Implementierte Funktionen in einem Satz je Eintrag" },
    "tests": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["command", "result", "commit", "at"],
        "properties": {
          "command": { "type": "string" },
          "result": { "enum": ["passed", "failed", "skipped", "not_run"] },
          "detail": { "type": "string" },
          "commit": { "$ref": "#/$defs/sha" },
          "at": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    "known_issues": { "type": "array", "items": { "type": "string" } },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "question", "owner"],
        "properties": { "id": { "type": "string" }, "question": { "type": "string" }, "owner": { "$ref": "#/$defs/system" } }
      }
    },
    "pr": {
      "type": "object", "additionalProperties": false, "required": ["url", "state"],
      "properties": {
        "url": { "type": ["string", "null"] },
        "state": { "enum": ["none", "draft", "open", "merged", "closed"] },
        "merge_commit": { "$ref": "#/$defs/sha" },
        "ci": { "enum": ["unknown", "pending", "green", "red"] }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["reviewer", "operator"],
      "properties": {
        "reviewer": { "enum": ["pending", "approved", "changes_requested"] },
        "operator": { "enum": ["pending", "approved", "rejected", "not_required"] },
        "latest_review_file": { "type": ["string", "null"] }
      }
    },
    "next_steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "last_checkpoint_at", "last_commit", "active_branch", "state_summary", "decisions_made", "test_status", "next_action"],
      "description": "Checkpoint für Sitzungswechsel und Kontextkomprimierung",
      "properties": {
        "system": { "$ref": "#/$defs/system" },
        "last_checkpoint_at": { "$ref": "#/$defs/timestamp" },
        "checkpoint_reason": { "enum": ["work_package_done", "tool_output_volume", "elapsed_time", "compaction_observed", "before_long_step", "session_end", "other"] },
        "last_commit": { "$ref": "#/$defs/sha" },
        "active_branch": { "type": ["string", "null"] },
        "state_summary": { "type": "string" },
        "decisions_made": { "type": "array", "items": { "type": "string" } },
        "test_status": { "type": "string" },
        "next_action": { "type": "string", "description": "Ein konkreter, ausführbarer nächster Schritt" }
      }
    },
    "revision": { "type": "integer", "minimum": 1, "description": "Bei jeder Änderung +1; nie überschreiben, wenn der Remote-Stand höher ist" },
    "based_on_commit": { "$ref": "#/$defs/sha" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "log": {
      "type": "array", "minItems": 1,
      "description": "Append-only Änderungsprotokoll",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["at", "actor", "action", "summary"],
        "properties": {
          "at": { "$ref": "#/$defs/timestamp" },
          "actor": { "$ref": "#/$defs/system" },
          "action": { "enum": ["created", "started", "checkpoint", "pushed", "pr_opened", "review_received", "fixed", "approved", "merged", "deployed", "verified", "blocked", "cancelled", "note"] },
          "summary": { "type": "string" },
          "commit": { "$ref": "#/$defs/sha" }
        }
      }
    }
  }
}
