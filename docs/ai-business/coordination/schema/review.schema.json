{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentstudiots-boop/affiliate-reel-agent/docs/ai-business/coordination/schema/review.schema.json",
  "title": "Review-Ergebnis (Schreibrecht: prüfendes System)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "round", "reviewer", "reviewed_commit", "pr_url", "verdict", "checklist", "findings", "tests_run", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^[A-J]-[0-9]{2}$" },
    "round": { "type": "integer", "minimum": 1 },
    "reviewer": { "enum": ["claude-code", "gpt-work"] },
    "reviewed_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "pr_url": { "type": ["string", "null"] },
    "verdict": { "enum": ["approve", "changes_requested", "comment"] },
    "checklist": {
      "type": "object", "additionalProperties": false,
      "description": "Prüfliste aus 05_ENTWICKLUNGSORGANISATION.md §5: ok | issue | n/a",
      "required": ["architecture", "approval_invariants", "security", "error_handling", "costs", "database", "tests", "integration", "tech_debt", "honest_status"],
      "properties": {
        "architecture": { "enum": ["ok", "issue", "n/a"] },
        "approval_invariants": { "enum": ["ok", "issue", "n/a"] },
        "security": { "enum": ["ok", "issue", "n/a"] },
        "error_handling": { "enum": ["ok", "issue", "n/a"] },
        "costs": { "enum": ["ok", "issue", "n/a"] },
        "database": { "enum": ["ok", "issue", "n/a"] },
        "tests": { "enum": ["ok", "issue", "n/a"] },
        "integration": { "enum": ["ok", "issue", "n/a"] },
        "tech_debt": { "enum": ["ok", "issue", "n/a"] },
        "honest_status": { "enum": ["ok", "issue", "n/a"] }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "severity", "file", "summary", "status"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["blocker", "major", "minor", "nit"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "summary": { "type": "string" },
          "failure_scenario": { "type": "string" },
          "status": { "enum": ["open", "fixed", "wont_fix", "invalid"] },
          "resolution": { "type": "string" }
        }
      }
    },
    "tests_run": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
