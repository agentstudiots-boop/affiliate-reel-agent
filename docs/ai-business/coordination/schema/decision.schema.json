{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentstudiots-boop/affiliate-reel-agent/docs/ai-business/coordination/schema/decision.schema.json",
  "title": "Betreiberentscheidung zu einer Aufgabe (Schreibrecht: Betreiber; technisch kann ein Modell die Datei im Auftrag schreiben, dann mit Quelle des Auftrags)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "decisions",
    "decided_by",
    "recorded_by",
    "source",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-J]-[0-9]{2}$"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "z. B. ADR-01, BF-03"
          },
          "question": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "approved",
              "rejected",
              "deferred",
              "changed"
            ]
          },
          "detail": {
            "type": "string"
          },
          "applies_to_commit": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{7,40}$"
          }
        }
      }
    },
    "decided_by": {
      "const": "operator"
    },
    "recorded_by": {
      "enum": [
        "operator",
        "claude-code",
        "gpt-work",
        "chatgpt-chat"
      ]
    },
    "source": {
      "type": "string",
      "description": "Wo die Entscheidung getroffen wurde (PR-Kommentar-Link, Chat-Datum). Eine von einem Modell eingetragene Entscheidung ohne nachprüfbare Quelle gilt nicht."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
