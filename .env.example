# Kostenlosen API-Schlüssel unter https://aistudio.google.com/api-keys erstellen.
# Nur in Vercel oder lokal in .env.local eintragen, niemals committen.
GOOGLE_GENERATIVE_AI_API_KEY=

# Neue Content-Planung: standardmäßig ohne API-Aufrufe im Referenzmodus.
# KI nur bewusst aktivieren; Zugangscode schützt kostenpflichtige Modellaufrufe.
CONTENT_AI_ENABLED=false
CONTENT_MODEL=
CONTENT_STUDIO_PASSWORD=
# Bereits verwendete Dienste (nur bei Bedarf konfigurieren):
TAVILY_API_KEY=
AMAZON_ASSOCIATE_TAG=alltaeglichle-21
RUNWAYML_API_SECRET=
RUNWAY_MONTHLY_BUDGET_CREDITS=1800
BLOB_READ_WRITE_TOKEN=

# Zentraler Postgres-Speicher (z. B. gepoolte Neon-Verbindung aus Vercel Marketplace).
# Nur serverseitig; niemals NEXT_PUBLIC_ verwenden. Migration: npm run db:migrate
DATABASE_URL=
