# Kostenlosen API-Schlüssel unter https://aistudio.google.com/api-keys erstellen.
# Nur in Vercel oder lokal in .env.local eintragen, niemals committen.
GOOGLE_GENERATIVE_AI_API_KEY=

# Meta: ausschließlich serverseitig. IDs werden nach Möglichkeit automatisch ermittelt.
META_SYSTEM_USER_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_PAGE_NAME=Alltäglich leichter
META_INSTAGRAM_USERNAME=alltaeglich.leichter
META_SYSTEM_USER_NAME=affiliatecontentsystem
# Optional, wenn automatische Asset-Suche keine eindeutige Zuordnung ergibt:
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_BUSINESS_ID=
# Schützt den optionalen einzelnen Gemini-Generierungstest (nie NEXT_PUBLIC_).
DIAGNOSTICS_SECRET=
GEMINI_DIAGNOSTICS_MODEL=gemini-2.5-flash
