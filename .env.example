# Content-Planung ohne generativen Modellanbieter. Tavily dient ausschließlich
# der aktuellen Trend-, Produkt- und Quellenrecherche.
CONTENT_STUDIO_PASSWORD=

# Recherche / Affiliate
TAVILY_API_KEY=
AMAZON_ASSOCIATE_TAG=alltaeglichle-21

# Bestehender Legacy-Renderer. Runway darf in der neuen Produktionslogik
# während der ersten 15 erfolgreichen Videos nicht gewählt werden.
RUNWAYML_API_SECRET=
RUNWAY_MONTHLY_BUDGET_CREDITS=1800
BLOB_READ_WRITE_TOKEN=

# Serverseitige Originalbilder für Facebook. Replicate ist primär, OpenAI sekundär.
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# Faceless.video: Key bereits ausschließlich serverseitig halten.
# Kein Endpoint wird angenommen, bis der offizielle API-Vertrag des Kontos verifiziert ist.
FACELESS_API_KEY=

# Zentraler Postgres-Speicher (z. B. gepoolte Neon-Verbindung aus Vercel Marketplace).
# Nur serverseitig; niemals NEXT_PUBLIC_ verwenden. Migration: npm run db:migrate
DATABASE_URL=
CRON_SECRET=

# Meta Facebook / Instagram: ausschließlich serverseitig.
META_SYSTEM_USER_TOKEN=
# Optional: Page-Token für Facebook-Fotos. Fehlt es, versucht der Server die
# Ableitung über die zugewiesene Seite; ohne geprüftes Page-Token kein POST.
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_PAGE_NAME=Alltäglich leichter
META_INSTAGRAM_USERNAME=alltaeglich.leichter
META_SYSTEM_USER_NAME=affiliatecontentsystem
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_BUSINESS_ID=

# WhatsApp Cloud API. Die ersten drei Werte sind bereits Teil des bestehenden Setups.
# WHATSAPP_VERIFY_TOKEN und META_APP_SECRET werden für den signierten Webhook benötigt.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APPROVER_WA_ID=
META_APP_SECRET=

# Optionale genehmigte WhatsApp-Vorlagen für initiierte Benachrichtigungen.
# Erst nach Meta-Genehmigung, Tarifprüfung und bewusster Aktivierung setzen.
WHATSAPP_DAILY_TEMPLATE_NAME=
WHATSAPP_DAILY_TEMPLATE_LANGUAGE=de
WHATSAPP_DAILY_TEMPLATE_ENABLED=false
WHATSAPP_WEEKLY_REPORT_TEMPLATE_NAME=
WHATSAPP_WEEKLY_REPORT_TEMPLATE_LANGUAGE=de
WHATSAPP_WEEKLY_REPORT_TEMPLATE_ENABLED=false

# WhatsApp-Instruction-Parser via Vercel AI Gateway: OIDC auf Vercel oder vorhandener Key.
AI_GATEWAY_API_KEY=
