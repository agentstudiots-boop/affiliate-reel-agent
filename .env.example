# Content-Planung ohne generativen Modellanbieter. Tavily dient ausschließlich
# der aktuellen Trend-, Produkt- und Quellenrecherche.
CONTENT_STUDIO_PASSWORD=
# Bereits verwendete Dienste (nur bei Bedarf konfigurieren):
TAVILY_API_KEY=
AMAZON_ASSOCIATE_TAG=alltaeglichle-21
RUNWAYML_API_SECRET=
RUNWAY_MONTHLY_BUDGET_CREDITS=1800
BLOB_READ_WRITE_TOKEN=
FACELESS_API_KEY=

# WhatsApp Cloud API. Der Verify-Token ist frei wählbar und muss identisch im
# Meta-Webhook hinterlegt werden. App Secret und Betreiber-Nummer sind nötig,
# damit eingehende Freigaben signiert geprüft und eindeutig autorisiert werden.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_OPERATOR_PHONE_NUMBER=
WHATSAPP_ALLOWED_SENDERS=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=de

# Sonntagabend in Europe/Berlin (Vercel Cron: Sonntag 18:00 UTC).
CRON_SECRET=

# Zentraler Postgres-Speicher (z. B. gepoolte Neon-Verbindung aus Vercel Marketplace).
# Nur serverseitig; niemals NEXT_PUBLIC_ verwenden. Migration: npm run db:migrate
DATABASE_URL=

# Meta: ausschließlich serverseitig. IDs werden nach Möglichkeit automatisch ermittelt.
META_SYSTEM_USER_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_PAGE_NAME=Alltäglich leichter
META_INSTAGRAM_USERNAME=alltaeglich.leichter
META_SYSTEM_USER_NAME=affiliatecontentsystem
# Optional, wenn automatische Asset-Suche keine eindeutige Zuordnung ergibt:
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_BUSINESS_ID=
