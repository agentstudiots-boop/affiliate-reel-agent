{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": ".test-build",
    "rootDir": ".",
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/content/**/*.ts",
    "lib/enterprise/registry.ts",
    "lib/enterprise/policy.ts",
    "lib/enterprise/plan.ts",
    "lib/enterprise/contract.ts",
    "lib/enterprise/tasks/repository.ts",
    "lib/enterprise/tasks/budget.ts",
    "lib/enterprise/decisions.ts",
    "lib/enterprise/departments/affiliate.ts",
    "lib/enterprise/cycle.ts",
    "lib/enterprise/planner.ts",
    "lib/product-resolver.ts",
    "lib/enterprise/opportunity/scoring.ts",
    "lib/enterprise/opportunity/economics.ts",
    "lib/enterprise/opportunity/operator-config.ts",
    "lib/enterprise/opportunity/ledger.ts",
    "lib/enterprise/opportunity/research.ts",
    "lib/daily/product-lock.ts",
    "lib/daily/slots.ts",
    "lib/daily/evidence.ts",
    "lib/affiliate-guard.ts",
    "lib/agents/content-chances.ts",
    "lib/memory/**/*.ts",
    "lib/meta/**/*.ts",
    "lib/production/**/*.ts",
    "lib/whatsapp/**/*.ts",
    "lib/reporting/**/*.ts",
    "lib/automation/**/*.ts",
    "lib/landing/**/*.ts",
    "lib/observability/**/*.ts",
    "lib/topics/**/*.ts",
    "lib/formats/**/*.ts",
    "lib/visual/**/*.ts",
    "lib/distribution/**/*.ts",
    "lib/topic-pipeline/**/*.ts",
    "lib/publishing/**/*.ts",
    "lib/capabilities/**/*.ts",
    "lib/security/**/*.ts",
    "lib/enterprise/controlling/import-model-calls.ts",
    "lib/enterprise/controlling/agent-departments.ts",
    "lib/enterprise/controlling/snapshot.ts",
    "lib/trendsetter/**/*.ts",
    "lib/architecture/**/*.ts",
    "app/architecture/enterprise-panel.tsx",
    "app/architecture/enterprise-planets.ts",
    "lib/tavily.ts",
    "lib/enterprise/controlling/metrics.ts"
  ]
}
