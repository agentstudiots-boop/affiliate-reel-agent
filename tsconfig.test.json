{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": ".test-build",
    "rootDir": ".",
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/content/**/*.ts",
    "lib/product-resolver.ts",
    "lib/daily/product-lock.ts",
    "lib/daily/slots.ts",
    "lib/affiliate-guard.ts",
    "lib/agents/content-chances.ts",
    "lib/memory/**/*.ts",
    "lib/meta/**/*.ts",
    "lib/production/**/*.ts",
    "lib/whatsapp/**/*.ts",
    "lib/reporting/**/*.ts",
    "lib/automation/**/*.ts",
    "lib/landing/**/*.ts",
    "lib/observability/**/*.ts",
    "lib/topics/**/*.ts",
    "lib/formats/**/*.ts",
    "lib/visual/**/*.ts",
    "lib/distribution/**/*.ts",
    "lib/topic-pipeline/**/*.ts",
    "lib/publishing/**/*.ts",
    "lib/capabilities/**/*.ts",
    "lib/tavily.ts"
  ]
}
